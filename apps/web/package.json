{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "python3 ../../scripts/build_museum_legacy_page_aliases.py && python3 ../../scripts/build_museum_nginx_legacy_redirects.py",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "python3 ../../scripts/build_csp.py out --output .csp-header.txt && playwright test",
    "test:cms": "playwright test --config playwright.cms.config.ts",
    "test:webkit": "python3 ../../scripts/build_csp.py out --output .csp-header.txt && playwright test --config playwright.webkit.config.ts",
    "test:chrome": "python3 ../../scripts/build_csp.py out --output .csp-header.txt && playwright test --config playwright.chrome.config.ts",
    "test:integrations": "node --experimental-strip-types --test src/integrations/*.test.ts",
    "test:reference": "node --experimental-strip-types --test src/data/museum-reference.test.ts",
    "test:search": "node --experimental-strip-types --test src/data/search-core.test.ts",
    "test:events": "node --experimental-strip-types --test src/data/event-archive.test.ts src/data/event-categories.test.ts src/data/current-exhibitions.test.ts",
    "test:navigation-tree": "node --experimental-strip-types --test src/data/navigation-tree.test.ts",
    "test:guide-rules": "node --experimental-strip-types --test src/data/guide-page-rules.test.ts",
    "test:seo": "node --experimental-strip-types --test src/data/seo-routes.test.ts",
    "test:official-docs": "node --experimental-strip-types --test src/data/museum-official-documents.test.ts",
    "build:museum-deploy": "../../.venv/bin/python ../../scripts/build_complete_museum_static_release.py --build",
    "verify:museum-deploy": "../../.venv/bin/python ../../scripts/build_complete_museum_static_release.py --verify-only"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "sass": "1.105.1",
    "typescript": "^5"
  }
}
