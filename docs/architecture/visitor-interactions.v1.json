{
  "version": 1,
  "lifecycle": "implemented-disabled-pending-customer-network-privacy-uat",
  "public": {
    "server": "nginx-static-only",
    "generator": "nextjs-static-export",
    "stores_personal_data": false,
    "can_contact_cms_or_db": false,
    "accepts_post": false
  },
  "search": {
    "index": "published-snapshot-build-time",
    "autocomplete": "browser-local",
    "cms_queries_at_runtime": false
  },
  "requests": {
    "current_delivery": "mailto-draft",
    "live_delivery": "two-vm-public-exact-post-proxy-to-private-isolated-ingress",
    "live_enabled": false,
    "kinds": [
      "feedback",
      "excursion"
    ],
    "ingress": {
      "method": "POST",
      "path": "/v1/requests",
      "isolated_from_static_host": true,
      "has_cms_or_database_route": false,
      "has_cms_secrets": false,
      "durable_encrypted_queue": true,
      "plaintext_persistent_storage": false,
      "max_payload_bytes": 8192,
      "rate_limit": true,
      "antispam": true,
      "attachments": false,
      "client_idempotency": "optional-random-128-bit-id-7-day-deduplication",
      "implementation": "services/request-ingress/public/index.php",
      "host_role": "private-vm-dedicated-restricted-php-fpm",
      "public_transport": "exact-post-path-nginx-mtls-reverse-proxy-only",
      "trusted_proxy_ip_required": true,
      "public_ingress_private_only": true,
      "private_worker_loopback_mtls": true,
      "proxy_exception_requires_customer_approval": true,
      "no_extra_virtual_machine": true
    },
    "closed_worker": {
      "initiates_private_mtls_pull": true,
      "public_inbound_access": false,
      "transfer_via_internet": false,
      "idempotent_import": true,
      "ack_after_durable_import": true,
      "implementation": "apps/cms/app/Console/Commands/PullMuseumInboundRequests.php"
    },
    "fields": {
      "name_max": 100,
      "message_max": 1200,
      "excursion_date": "YYYY-MM-DD",
      "group_min": 1,
      "group_max": 100,
      "personal_data_notice_approved_required": true,
      "extra_fields": false,
      "email_max": 254
    },
    "http": {
      "accepted": 202,
      "invalid": 422,
      "limited": 429,
      "unavailable": 503,
      "accepted_is_booking_confirmation": false
    },
    "activation_requires": [
      "customer-written-approval-of-exact-post-proxy-exception-to-static-only",
      "museum-approved-forms-workflow",
      "museum-approved-personal-data-notice-and-retention",
      "two-vm-private-network-and-fail-closed-firewall",
      "dedicated-locked-down-ingress-fpm-on-private-vm",
      "verified-mtls-and-private-loopback-poller",
      "synthetic-end-to-end-uat-and-museum-acceptance"
    ]
  },
  "third_party": {
    "tickets": "official-external-link",
    "maps": "opt-in-embed",
    "socials": "official-links",
    "video": "opt-in-embed",
    "analytics_enabled": false
  }
}
